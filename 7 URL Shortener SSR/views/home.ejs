<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
</head>
<body>
    <h1>Home - URL Shortener</h1>

    <form method="POST" action="/url/">
        <label for="url">Enter the original URL: </label>
        <input 
            type="text"
            name="url"
            placeholder="https://example.com"
        >
        <button>Generate</button>
    </form>

    <br>

    <table> 
        <thead>
            <th>Index</th>
            <th>Short-Id</th>
            <th>Redirect URL</th>
            <th>Total Visits</th>
            <th>Redirect</th>
        </thead>
        <tbody>
            <% urls.forEach((url, ind) => { %>
                <tr>
                    <td><%= ind+1 %></td> 
                    <td><%= url.shortId %></td> 
                    <td><%= url.redirectURL %></td>
                    <td><%= url.visitHistory.length %></td>
                    <td><button onclick="handleRedirect('<%= url.shortId  %>')">Go</button></td>
                </tr>
            <% }); %>
        </tbody>
        </table>

        <script>
            async function handleRedirect(shortId) {
                window.open(`http://localhost:8000/url/${shortId}`, "_blank", "noopener")
            }
        </script>
</body>
</html>