<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
</head>
<body>
    <h1>This is home View</h1>
    <table> 
        <thead>
            <th>Index</th>
            <th>Short-Id</th>
            <th>Redirect URL</th>
            <th>Total Visits</th>
        </thead>
        <tbody>
            <% urls.forEach((url, ind) => { %>
                <tr>
                    <td><%= ind+1 %></td> 
                    <td><%= url.shortId %></td> 
                    <td><%= url.redirectURL %></td>
                    <td><%= url.visitHistory.length %></td>
                </tr>
            <% }); %>
        </tbody>
        </table>
</body>
</html>