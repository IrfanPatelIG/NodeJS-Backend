<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
</head>
<body>
    <h1>Home - URL Shortener</h1>

    <form method="POST" action="/url/">
        <label for="url">Enter the original URL: </label>
        <input 
            type="text"
            name="url"
            placeholder="https://example.com"
        >
        <button>Generate</button>
    </form>

    <% if (locals.id) { %>
        <div>
            URL Generated: http://localhost:8000/url/<%= id %>
        </div>
    <% } %>

    <br>

   
</body>
</html>