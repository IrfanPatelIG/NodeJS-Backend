<nav class="navbar sm:navbar-expand bg-1 fg-2">
  <div class="container-fluid">
    <a class="navbar-brand" href="/" style="font-size: 175%; font-weight: 600;">
        BLOGit
    </a>

    <button class="btn-icon navbar-toggler" type="button" data-bs-toggle="drawer" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon" aria-hidden="true"></span>
    </button>
    <dialog class="drawer drawer-end" tabindex="-1" id="navbarNavAltMarkup" aria-labelledby="navbarNavAltMarkupLabel">
        <div class="drawer-header">
            <h5 class="drawer-title" id="navbarNavAltMarkupLabel">Menu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Close"></button>
        </div>
        <div class="drawer-body" style="justify-content: flex-end !important;">
            <div class="nav nav-pills navbar-nav">
                <a class="nav-link active" aria-current="page" href="/">Home</a>
                <% if (locals.user && locals.currentPath !== "/blog/add-new") { %>
                    <a class="nav-link" href="/blog/add-new">Add Blog</a>
                <% } %>
                <a class="nav-link" style="margin-right: 20px;" href="#">About</a>

                <% if (locals.user) { %>
                    <a class="btn-solid theme-primary fs-lg px-6" href="#" role="button" data-bs-toggle="menu" aria-expanded="false">
                        <%= locals.user? user.fullName.split(" ")[0] : "User" %>
                    </a>
                    <div class="menu menu-translucent">
                        <a class="menu-item" href="#">Profile</a>
                        <a class="menu-item theme-danger" href="/user/logout">Logout</a>
                    </div>
                <% } else { %>

                    <% if (locals.currentPath === "/user/signin") { %>
                        <a class="btn-solid theme-primary" href="/user/signup" role="button">
                            SignUp
                        </a>
                    <% } else { %>
                        <a class="btn-solid theme-primary" href="/user/signin" role="button">
                            SignIn
                        </a>
                    <% } %>

                <% } %>
            </div>
        </div>
    </dialog>
  </div>
</nav>

<% if (locals.error) { %>
    <div class="container mt-4">
        <div class="alert theme-danger" role="alert">
            <p><%= locals.error %></p>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
<% } %>