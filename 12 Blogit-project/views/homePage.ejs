<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BLOGit - Home Page</title>
    <%- include("./partials/head") %>
</head>
<body>
    <%- include("./partials/navBar", {
        user: locals.user? user : null,
        error: locals.error? error : null
    }) %>

    <main class="container pt-4">
        <h1>Welcome, Home
            <% if (locals.user) { %>
                <span>- </span><%= user.fullName.split(" ")[0] %>
            <% } %>
        </h1>
        <% if (locals.blogs) { %>
            
            <div class="container">
                <span>Total Blogs Added: <%- blogs.length %></span>
            </div>

        <% } %>
    </main>
    
    <%- include("./partials/scripts") %>
</html> 