<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BLOGit - Home Page</title>
    <%- include("./partials/head") %>
</head>
<body>
    <%- include("./partials/navBar", {user: locals.user? user : null}) %>

    <main class="container pt-4">
        <h1>Welcome, Home
            <% if (locals.user) { %>
                <span>- </span><%= user.fullName.split(" ")[0] %>
            <% } %>
        </h1>
        <% if (locals.user) { %>
            <p class="mt-10">User: <%= JSON.stringify(user) %></p>
        <% } %>
    </main>
    
    <%- include("./partials/scripts") %>
</html> 